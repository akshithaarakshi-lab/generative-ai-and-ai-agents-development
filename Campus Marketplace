        "# ============================================================\n",
        "# 4. AUTHENTICATION\n",
        "# ============================================================\n",
        "\n",
        "LOGIN_TEMPLATE = \"\"\"\n",
        "<div class=\"card\">\n",
        "    <h2>Welcome to Campus Marketplace</h2>\n",
        "\n",
        "    <p>\n",
        "        Log in to browse products, search for items\n",
        "        and list your own products.\n",
        "    </p>\n",
        "\n",
        "    {% if error %}\n",
        "        <div class=\"error\">{{ error }}</div>\n",
        "    {% endif %}\n",
        "\n",
        "    <form method=\"POST\" action=\"{{ url_for('security') }}\">\n",
        "        <input type=\"hidden\" name=\"csrf_token\" value=\"{{ csrf_token }}\">\n",
        "\n",
        "        <label>Enter Password</label>\n",
        "        <input\n",
        "            type=\"password\"\n",
        "            name=\"password\"\n",
        "            placeholder=\"Enter demo password\"\n",
        "            required\n",
        "        >\n",
        "\n",
        "        <button type=\"submit\">Login</button>\n",
        "    </form>\n",
        "\n",
        "    <p class=\"muted\">\n",
        "        Demonstration password: 1234\n",
        "    </p>\n",
        "</div>\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "@app.before_request\n",
        "def protect_post_requests():\n",
        "    # Basic CSRF protection for form submissions.\n",
        "    if request.method == \"POST\":\n",
        "        submitted_token = request.form.get(\"csrf_token\", \"\")\n",
        "        expected_token = session.get(\"csrf_token\", \"\")\n",
        "\n",
        "        if not expected_token or not hmac.compare_digest(\n",
        "            submitted_token, expected_token\n",
        "        ):\n",
        "            return \"Invalid or expired form token. Reload the page.\", 400\n",
        "\n",
        "\n",
        "@app.route(\"/security\", methods=[\"GET\", \"POST\"])\n",
        "def security():\n",
        "\n",
        "    if session.get(\"access\"):\n",
        "        return redirect(url_for(\"home\"))\n",
        "\n",
        "    error = None\n",
        "\n",
        "    if request.method == \"POST\":\n",
        "        password = request.form.get(\"password\", \"\")\n",
        "\n",
        "        if hmac.compare_digest(password, DEMO_PASSWORD):\n",
        "            session.clear()\n",
        "            session[\"access\"] = True\n",
        "            session[\"csrf_token\"] = secrets.token_urlsafe(32)\n",
        "\n",
        "            return redirect(url_for(\"home\"))\n",
        "\n",
        "        error = \"Incorrect password. Please try again.\"\n",
        "\n",
        "    # Generate a token for the login form.\n",
        "    if not session.get(\"csrf_token\"):\n",
        "        session[\"csrf_token\"] = secrets.token_urlsafe(32)\n",
        "\n",
        "    return render_page(\n",
        "        \"Login\",\n",
        "        LOGIN_TEMPLATE,\n",
        "        error=error,\n",
        "        csrf_token=session[\"csrf_token\"]\n",
        "    )\n",
        "\n",
        "\n",
        "@app.route(\"/logout\")\n",
        "def logout():\n",
        "    session.clear()\n",
        "    return redirect(url_for(\"security\"))\n",
        "\n",
        "\n",
        "def login_required():\n",
        "    if not session.get(\"access\"):\n",
        "        return redirect(url_for(\"security\"))\n",
        "\n",
        "    return None\n",
        "\n",
