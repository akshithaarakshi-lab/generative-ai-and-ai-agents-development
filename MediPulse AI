      "source": [
        "import gradio as gr\n",
        "import pandas as pd\n",
        "from datetime import datetime, date, timedelta\n",
        "\n",
        "# ============================================================\n",
        "# CARECONNECT AI\n",
        "# Smart Patient Follow-Up, Appointment & Notification System\n",
        "# ============================================================\n",
        "\n",
        "# -----------------------------\n",
        "# DEMO PATIENT DATA\n",
        "# -----------------------------\n",
        "patients = pd.DataFrame([\n",
        "    {\n",
        "        \"Patient_ID\": \"P001\",\n",
        "        \"Name\": \"Akshitha\",\n",
        "        \"Phone\": \"+919740225204\",\n",
        "        \"Age\": 21,\n",
        "        \"Disease\": \"General Follow-up\",\n",
        "        \"Doctor\": \"Dr. Aarti\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Last_Checkup\": \"2026-09-15\",\n",
        "        \"Next_Checkup\": \"2026-10-15\",\n",
        "        \"Followup_Days\": 30,\n",
        "        \"Missed_Visits\": 0,\n",
        "        \"Adherence\": 95,\n",
        "        \"SMS_Consent\": \"Yes\"\n",
        "    },\n",
        "    {\n",
        "        \"Patient_ID\": \"P002\",\n",
        "        \"Name\": \"Rahul Kumar\",\n",
        "        \"Phone\": \"+919000000001\",\n",
        "        \"Age\": 55,\n",
        "        \"Disease\": \"Diabetes\",\n",
        "        \"Doctor\": \"Dr. Anusha\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Last_Checkup\": \"2026-09-20\",\n",
        "        \"Next_Checkup\": \"2026-10-20\",\n",
        "        \"Followup_Days\": 30,\n",
        "        \"Missed_Visits\": 1,\n",
        "        \"Adherence\": 85,\n",
        "        \"SMS_Consent\": \"Yes\"\n",
        "    },\n",
        "    {\n",
        "        \"Patient_ID\": \"P003\",\n",
        "        \"Name\": \"Priya Sharma\",\n",
        "        \"Phone\": \"+919000000002\",\n",
        "        \"Age\": 48,\n",
        "        \"Disease\": \"Hypertension\",\n",
        "        \"Doctor\": \"Dr. Kuldeep\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Last_Checkup\": \"2026-09-25\",\n",
        "        \"Next_Checkup\": \"2026-10-25\",\n",
        "        \"Followup_Days\": 30,\n",
        "        \"Missed_Visits\": 0,\n",
        "        \"Adherence\": 92,\n",
        "        \"SMS_Consent\": \"Yes\"\n",
        "    }\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# DEMO DOCTOR DATA\n",
        "# -----------------------------\n",
        "doctors = pd.DataFrame([\n",
        "    {\n",
        "        \"Doctor\": \"Dr. Aarti\",\n",
        "        \"Specialization\": \"General Medicine\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Available_Days\": \"Monday, Wednesday, Friday\",\n",
        "        \"Available_Time\": \"10:00 AM - 2:00 PM\"\n",
        "    },\n",
        "    {\n",
        "        \"Doctor\": \"Dr. Anusha\",\n",
        "        \"Specialization\": \"Diabetology\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Available_Days\": \"Tuesday, Thursday, Saturday\",\n",
        "        \"Available_Time\": \"10:00 AM - 3:00 PM\"\n",
        "    },\n",
        "    {\n",
        "        \"Doctor\": \"Dr. Kuldeep\",\n",
        "        \"Specialization\": \"Cardiology\",\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Available_Days\": \"Monday, Thursday, Saturday\",\n",
        "        \"Available_Time\": \"11:00 AM - 4:00 PM\"\n",
        "    }\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# APPOINTMENTS\n",
        "# -----------------------------\n",
        "appointments = pd.DataFrame(columns=[\n",
        "    \"Appointment_ID\",\n",
        "    \"Patient_ID\",\n",
        "    \"Patient_Name\",\n",
        "    \"Doctor\",\n",
        "    \"Hospital\",\n",
        "    \"Date\",\n",
        "    \"Time\",\n",
        "    \"Status\"\n",
        "])\n",
        "\n",
        "# -----------------------------\n",
        "# NOTIFICATION LOG\n",
        "# -----------------------------\n",
        "notification_log = pd.DataFrame(columns=[\n",
        "    \"Patient_ID\",\n",
        "    \"Patient_Name\",\n",
        "    \"Phone\",\n",
        "    \"Notification\",\n",
        "    \"Date\",\n",
        "    \"Status\"\n",
        "])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# HELPER FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def find_patient(patient_name):\n",
        "    if not patient_name:\n",
        "        return None\n",
        "    result = patients[\n",
        "        patients[\"Name\"].str.lower() == patient_name.strip().lower()\n",
        "    ]\n",
        "\n",
        "    if len(result) == 0:\n",
        "        return None\n",
        "\n",
        "    return result.iloc[0]\n",
        "\n",
        "\n",
        "def create_message(patient):\n",
        "    message = (\n",
        "        f\"CareConnect AI Reminder\\n\\n\"\n",
        "        f\"Hello {patient['Name']},\\n\"\n",
        "        f\"Your next check-up is due on {patient['Next_Checkup']}.\\n\\n\"\n",
        "        f\"Doctor: {patient['Doctor']}\\n\"\n",
        "        f\"Hospital: {patient['Hospital']}\\n\"\n",
        "        f\"Disease/Condition: {patient['Disease']}\\n\\n\"\n",
        "        f\"Please attend your follow-up appointment on time.\\n\\n\"\n",
        "        f\"- CareConnect AI\"\n",
        "    )\n",
        "    return message\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PATIENT DASHBOARD\n",
        "# ============================================================\n",
        "\n",
        "def patient_dashboard(patient_name):\n",
        "    patient = find_patient(patient_name)\n",
        "\n",
        "    if patient is None:\n",
        "        return \"❌ Patient not found.\", \"\"\n",
        "\n",
        "    next_date = datetime.strptime(\n",
        "        patient[\"Next_Checkup\"], \"%Y-%m-%d\"\n",
        "    ).date()\n",
        "\n",
        "    today = date.today()\n",
        "    days_remaining = (next_date - today).days\n",
        "\n",
        "    if days_remaining > 7:\n",
        "        status = f\"🟢 Check-up in {days_remaining} days\"\n",
        "    elif days_remaining > 1:\n",
        "        status = f\"🟡 Check-up in {days_remaining} days\"\n",
        "    elif days_remaining == 1:\n",
        "        status = \"🟠 Check-up is tomorrow\"\n",
        "    elif days_remaining == 0:\n",
        "        status = \"🔴 Check-up is TODAY\"\n",
        "    else:\n",
        "        status = f\"🚨 Follow-up overdue by {abs(days_remaining)} days\"\n",
        "\n",
        "    info = f\"\"\"\n",
        "# 👤 Patient Dashboard\n",
        "\n",
        "### Patient Information\n",
        "\n",
        "**Patient ID:** {patient[\"Patient_ID\"]}\n",
        "\n",
        "**Name:** {patient[\"Name\"]}\n",
        "\n",
        "**Phone:** {patient[\"Phone\"]}\n",
        "\n",
        "**Age:** {patient[\"Age\"]}\n",
        "\n",
        "**Condition:** {patient[\"Disease\"]}\n",
        "\n",
        "---\n",
        "\n",
        "### 🏥 Treatment Information\n",
        "\n",
        "**Doctor:** {patient[\"Doctor\"]}\n",
        "\n",
        "**Hospital:** {patient[\"Hospital\"]}\n",
        "\n",
        "**Last Check-up:** {patient[\"Last_Checkup\"]}\n",
        "\n",
        "**Next Check-up:** {patient[\"Next_Checkup\"]}\n",
        "\n",
        "### 📅 Follow-up Status\n",
        "\n",
        "{status}\n",
        "\n",
        "### 💊 Medication Adherence\n",
        "\n",
        "{patient[\"Adherence\"]}%\n",
        "\n",
        "### ❗ Missed Visits\n",
        "\n",
        "{patient[\"Missed_Visits\"]}\n",
        "\"\"\"\n",
        "\n",
        "    message = create_message(patient)\n",
        "    return info, message\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DOCTOR AVAILABILITY\n",
        "# ============================================================\n",
        "\n",
        "def show_doctors():\n",
        "    return doctors.copy()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# APPOINTMENT BOOKING\n",
        "# ============================================================\n",
        "\n",
        "def book_appointment(patient_name, doctor_name, appointment_date, appointment_time):\n",
        "    global appointments\n",
        "\n",
        "    patient = find_patient(patient_name)\n",
        "    if patient is None:\n",
        "        return \"❌ Patient not found.\"\n",
        "\n",
        "    if doctor_name not in doctors[\"Doctor\"].values:\n",
        "        return \"❌ Doctor not found.\"\n",
        "\n",
        "    if appointment_date == \"\":\n",
        "        return \"❌ Please select an appointment date.\"\n",
        "\n",
        "    if appointment_time == \"\":\n",
        "        return \"❌ Please select an appointment time.\"\n",
        "\n",
        "    appointment_id = \"A\" + str(len(appointments) + 1).zfill(3)\n",
        "\n",
        "    new_appointment = {\n",
        "        \"Appointment_ID\": appointment_id,\n",
        "        \"Patient_ID\": patient[\"Patient_ID\"],\n",
        "        \"Patient_Name\": patient[\"Name\"],\n",
        "        \"Doctor\": doctor_name,\n",
        "        \"Hospital\": \"Narayana Hospital\",\n",
        "        \"Date\": appointment_date,\n",
        "        \"Time\": appointment_time,\n",
        "        \"Status\": \"Booked\"\n",
        "    }\n",
        "\n",
        "    appointments.loc[len(appointments)] = new_appointment\n",
        "\n",
        "    return f\"\"\"\n",
        "# ✅ Appointment Confirmed\n",
        "\n",
        "**Appointment ID:** {appointment_id}\n",
        "\n",
        "**Patient:** {patient[\"Name\"]}\n",
        "\n",
        "**Doctor:** {doctor_name}\n",
        "\n",
        "**Hospital:** Narayana Hospital\n",
        "\n",
        "**Date:** {appointment_date}\n",
        "\n",
        "**Time:** {appointment_time}\n",
        "\n",
        "📱 A confirmation notification can be sent to:\n",
        "\n",
        "**{patient[\"Phone\"]}**\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DEMO SMS NOTIFICATION\n",
        "# ============================================================\n",
        "\n",
        "def notify_patient(patient_name):\n",
        "    global notification_log\n",
        "\n",
        "    patient = find_patient(patient_name)\n",
        "    if patient is None:\n",
        "        return \"❌ Please select a patient first to send a notification.\"\n",
        "\n",
        "    if patient[\"SMS_Consent\"] != \"Yes\":\n",
        "        return \"❌ Patient has not given SMS consent.\"\n",
        "\n",
        "    message = create_message(patient)\n",
        "\n",
        "    notification_log.loc[len(notification_log)] = {\n",
        "        \"Patient_ID\": patient[\"Patient_ID\"],\n",
        "        \"Patient_Name\": patient[\"Name\"],\n",
        "        \"Phone\": patient[\"Phone\"],\n",
        "        \"Notification\": message,\n",
        "        \"Date\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
        "        \"Status\": \"Demo notification generated\"\n",
        "    }\n",
        "\n",
        "    return f\"\"\"\n",
        "# 🔔 Notification Generated\n",
        "\n",
        "**Patient:** {patient[\"Name\"]}\n",
        "\n",
        "**Phone:** {patient[\"Phone\"]}\n",
        "\n",
        "**Status:** ✅ Notification ready\n",
        "\n",
        "---\n",
        "\n",
        "### 📱 SMS Content\n",
        "\n",
        "{message}\n",
        "\n",
        "---\n",
        "\n",
        "⚠️ **Demo Mode**\n",
        "\n",
        "This button generates the real SMS content, but an SMS provider\n",
        "must be connected to actually deliver it to the phone.\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# REGISTER NEW PATIENT\n",
        "# ============================================================\n",
        "\n",
        "def register_patient(\n",
        "    name,\n",
        "    phone,\n",
        "    age,\n",
        "    disease,\n",
        "    doctor,\n",
        "    hospital,\n",
        "    last_checkup,\n",
        "    followup_days\n",
        "):\n",
        "    global patients\n",
        "\n",
        "    if name.strip() == \"\":\n",
        "        return \"❌ Enter patient name.\", gr.update(), gr.update()\n",
        "\n",
        "    if phone.strip() == \"\":\n",
        "        return \"❌ Enter phone number.\", gr.update(), gr.update()\n",
        "\n",
        "    if not phone.startswith(\"+\"):\n",
        "        return \"❌ Enter phone number in international format. Example: +919876543210\", gr.update(), gr.update()\n",
        "\n",
        "    try:\n",
        "        age = int(age)\n",
        "        followup_days = int(followup_days)\n",
        "    except:\n",
        "        return \"❌ Age and follow-up days must be numbers.\", gr.update(), gr.update()\n",
        "\n",
        "    try:\n",
        "        last_date = datetime.strptime(\n",
        "            last_checkup, \"%Y-%m-%d\"\n",
        "        ).date()\n",
        "    except:\n",
        "        return \"❌ Date must be YYYY-MM-DD.\", gr.update(), gr.update()\n",
        "\n",
        "    next_date = last_date + timedelta(days=followup_days)\n",
        "    patient_id = \"P\" + str(len(patients) + 1).zfill(3)\n",
        "\n",
        "    new_patient = {\n",
        "        \"Patient_ID\": patient_id,\n",
        "        \"Name\": name,\n",
        "        \"Phone\": phone,\n",
        "        \"Age\": age,\n",
        "        \"Disease\": disease,\n",
        "        \"Doctor\": doctor,\n",
        "        \"Hospital\": hospital,\n",
        "        \"Last_Checkup\": str(last_date),\n",
        "        \"Next_Checkup\": str(next_date),\n",
        "        \"Followup_Days\": followup_days,\n",
        "        \"Missed_Visits\": 0,\n",
        "        \"Adherence\": 100,\n",
        "        \"SMS_Consent\": \"Yes\"\n",
        "    }\n",
        "\n",
        "    patients.loc[len(patients)] = new_patient\n",
        "    updated_names = patients[\"Name\"].tolist()\n",
        "\n",
        "    success_msg = f\"\"\"\n",
        "# ✅ Patient Registered Successfully\n",
        "\n",
        "**Patient ID:** {patient_id}\n",
        "\n",
        "**Patient:** {name}\n",
        "\n",
        "**Phone:** {phone}\n",
        "\n",
        "**Doctor:** {doctor}\n",
        "\n",
        "**Hospital:** {hospital}\n",
        "\n",
        "**Next Check-up:** {next_date}\n",
        "\n",
        "📱 Notification is enabled for this patient.\n",
        "\"\"\"\n",
        "    return success_msg, gr.update(choices=updated_names), gr.update(choices=updated_names)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DOCTOR DASHBOARD\n",
        "# ============================================================\n",
        "\n",
        "def doctor_dashboard(doctor_name):\n",
        "    doctor_patients = patients[\n",
        "        patients[\"Doctor\"] == doctor_name\n",
        "    ]\n",
        "\n",
        "    if len(doctor_patients) == 0:\n",
        "        return \"No patients found for this doctor.\"\n",
        "\n",
        "    display = doctor_patients[\n",
        "        [\n",
        "            \"Patient_ID\",\n",
        "            \"Name\",\n",
        "            \"Phone\",\n",
        "            \"Disease\",\n",
        "            \"Next_Checkup\",\n",
        "            \"Missed_Visits\",\n",
        "            \"Adherence\"\n",
        "        ]\n",
        "    ]\n",
        "    return display\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# HOSPITAL DASHBOARD\n",
        "# ============================================================\n",
        "\n",
        "def hospital_dashboard():\n",
        "    total_patients = len(patients)\n",
        "    total_doctors = len(doctors)\n",
        "    total_appointments = len(appointments)\n",
        "\n",
        "    overdue = 0\n",
        "    today = date.today()\n",
        "\n",
        "    for _, patient in patients.iterrows():\n",
        "        next_date = datetime.strptime(\n",
        "            patient[\"Next_Checkup\"], \"%Y-%m-%d\"\n",
        "        ).date()\n",
        "        if next_date < today:\n",
        "            overdue += 1\n",
        "\n",
        "    result = f\"\"\"\n",
        "# 🏥 Hospital Administration Dashboard\n",
        "\n",
        "### 👥 Total Patients\n",
        "## {total_patients}\n",
        "\n",
        "### 👨‍⚕️ Total Doctors\n",
        "## {total_doctors}\n",
        "\n",
        "### 📅 Total Appointments\n",
        "## {total_appointments}\n",
        "\n",
        "### 🚨 Overdue Follow-ups\n",
        "## {overdue}\n",
        "\n",
        "---\n",
        "\n",
        "### Patient Database\n",
        "\"\"\"\n",
        "    return result, patients\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ALL APPOINTMENTS\n",
        "# ============================================================\n",
        "\n",
        "def show_appointments():\n",
        "    if len(appointments) == 0:\n",
        "        return pd.DataFrame(\n",
        "            columns=[\n",
        "                \"Appointment_ID\",\n",
        "                \"Patient_ID\",\n",
        "                \"Patient_Name\",\n",
        "                \"Doctor\",\n",
        "                \"Hospital\",\n",
        "                \"Date\",\n",
        "                \"Time\",\n",
        "                \"Status\"\n",
        "            ]\n",
        "        )\n",
        "    return appointments\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# NOTIFICATION LOG\n",
        "# ============================================================\n",
        "\n",
        "def show_notifications():\n",
        "    if len(notification_log) == 0:\n",
        "        return pd.DataFrame(\n",
        "            columns=[\n",
        "                \"Patient_ID\",\n",
        "                \"Patient_Name\",\n",
        "                \"Phone\",\n",
        "                \"Notification\",\n",
        "                \"Date\",\n",
        "                \"Status\"\n",
        "            ]\n",
        "        )\n",
        "    return notification_log\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# AUTOMATIC REMINDER CHECK\n",
        "# ============================================================\n",
        "\n",
        "def reminder_check():\n",
        "    today = date.today()\n",
        "    rows = []\n",
        "\n",
        "    for _, patient in patients.iterrows():\n",
        "        next_date = datetime.strptime(\n",
        "            patient[\"Next_Checkup\"], \"%Y-%m-%d\"\n",
        "        ).date()\n",
        "        days_left = (next_date - today).days\n",
        "\n",
        "        if days_left == 7:\n",
        "            reminder = \"7-day reminder\"\n",
        "        elif days_left == 3:\n",
        "            reminder = \"3-day reminder\"\n",
        "        elif days_left == 1:\n",
        "            reminder = \"1-day reminder\"\n",
        "        elif days_left == 0:\n",
        "            reminder = \"Check-up today\"\n",
        "        elif days_left < 0:\n",
        "            reminder = \"Overdue\"\n",
        "        else:\n",
        "            continue\n",
        "\n",
        "        rows.append({\n",
        "            \"Patient\": patient[\"Name\"],\n",
        "            \"Phone\": patient[\"Phone\"],\n",
        "            \"Doctor\": patient[\"Doctor\"],\n",
        "            \"Next Check-up\": patient[\"Next_Checkup\"],\n",
        "            \"Days Remaining\": days_left,\n",
        "            \"Reminder\": reminder\n",
        "        })\n",
        "\n",
        "    if len(rows) == 0:\n",
        "        return pd.DataFrame(\n",
        "            columns=[\n",
        "                \"Patient\",\n",
        "                \"Phone\",\n",
        "                \"Doctor\",\n",
        "                \"Next Check-up\",\n",
        "                \"Days Remaining\",\n",
        "                \"Reminder\"\n",
        "            ]\n",
        "        )\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# GRADIO INTERFACE\n",
        "# ============================================================\n",
        "\n",
        "with gr.Blocks(\n",
        "    title=\"CareConnect AI\"\n",
        ") as app:\n",
        "\n",
        "    gr.Markdown(\"\"\"\n",
        "# 🏥 CareConnect AI\n",
        "\n",
        "## Smart Patient Follow-Up, Appointment & Notification System\n",
        "\n",
        "**Purpose:** Ensure that patients are not treated once and forgotten.\n",
        "The system keeps track of follow-ups, appointments, doctor availability,\n",
        "and patient notifications.\n",
        "\"\"\")\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # PATIENT DASHBOARD\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    with gr.Tab(\"👤 Patient Dashboard\"):\n",
        "\n",
        "        patient_dropdown = gr.Dropdown(\n",
