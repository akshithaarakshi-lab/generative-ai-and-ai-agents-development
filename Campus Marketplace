        "\"\"\"\n",
        "\n",
        "\n",
        "def get_products(search_text=\"\"):\n",
        "    connection = get_db()\n",
        "\n",
        "    if search_text:\n",
        "        term = \"%\" + search_text + \"%\"\n",
        "\n",
        "        rows = connection.execute(\"\"\"\n",
        "            SELECT * FROM products\n",
        "            WHERE name LIKE ?\n",
        "               OR category LIKE ?\n",
        "               OR description LIKE ?\n",
        "            ORDER BY id DESC\n",
        "        \"\"\", (term, term, term)).fetchall()\n",
        "\n",
        "    else:\n",
        "        rows = connection.execute(\"\"\"\n",
        "            SELECT * FROM products\n",
        "            ORDER BY id DESC\n",
        "        \"\"\").fetchall()\n",
        "\n",
        "    connection.close()\n",
        "    return rows\n",
        "\n",
        "\n",
        "@app.route(\"/products\")\n",
