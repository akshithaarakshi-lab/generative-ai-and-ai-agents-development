        "    if check:\n",
        "        return check\n",
        "\n",
        "    name = request.form.get(\"name\", \"\").strip()\n",
        "    category = request.form.get(\"category\", \"\").strip()\n",
        "    description = request.form.get(\"description\", \"\").strip()\n",
        "    price_text = request.form.get(\"price\", \"\").strip()\n",
        "\n",
        "    allowed_categories = {\n",
        "        \"Books\",\n",
        "        \"Electronics\",\n",
        "        \"Accessories\",\n",
